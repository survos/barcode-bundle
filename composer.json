{
    "name": "survos/barcode-bundle",
    "description": "Integrates picqer/php-barcode-generator in a Symfony application",
    "license": "MIT",
    "authors": [
        {
            "name": "Tac Tacelosky",
            "email": "tacman@gmail.com"
        }
    ],
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "picqer/php-barcode-generator": "^3.2",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "twig/twig": "^3.4|^4.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/framework-bundle": "^8.1",
        "symfony/yaml": "^8.1",
        "survos/step-bundle": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Survos\\BarcodeBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\BarcodeBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan"
    }
}
