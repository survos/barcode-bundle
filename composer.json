{
    "name": "survos/barcode-bundle",
    "description": "Integrates picqer/php-barcode-generator in a Symfony application",
    "license": "MIT",
    "authors": [
        {
            "name": "Tac Tacelosky",
            "email": "tacman@gmail.com"
        }
    ],
    "type": "symfony-bundle",
    "require": {
        "php": "^8.4",
        "picqer/php-barcode-generator": "^3.2",
        "symfony/config": "^7.3||^8.0",
        "symfony/dependency-injection": "^7.3||^8.0",
        "symfony/http-kernel": "^7.3||^8.0",
        "twig/twig": "^3.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12",
        "symfony/framework-bundle": "^7.3||^8.0",
        "symfony/yaml": "^7.3||^8.0",
        "survos/step-bundle": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Survos\\BarcodeBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\BarcodeBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan"
    }
}